# Global environment variables for containers
#
# `make setup` copies this template to env.docker, which is git-ignored.
# All values are local development defaults; change them before exposing
# any service beyond your own machine.
POSTGRES_USER=marquez
POSTGRES_PASSWORD=marquez
POSTGRES_DB=marquez
MARQUEZ_PORT=5001
MARQUEZ_ADMIN_PORT=5002
SEARCH_ENABLED=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
