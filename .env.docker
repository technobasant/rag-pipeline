# MinIO Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=datalake
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Airflow Configuration
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres/airflow

AIRFLOW__CORE__FERNET_KEY=''
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth,airflow.api.auth.backend.session
AIRFLOW__WEBSERVER__SECRET_KEY=your_super_secret_key_here

# Spark Configuration
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=1G
SPARK_EXECUTOR_MEMORY=1G

# Chroma Configuration
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=documents

# Ollama Configuration
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_MODEL="qwen3:0.6b"
OLLAMA_EMBED_MODEL="mahonzhan/all-MiniLM-L6-v2"

# Scraper Configuration
SCRAPE_BASE_URL=https://docs.python.org/3/tutorial/
SCRAPE_MAX_PAGES=50
SCRAPE_DELAY_SECONDS=1
SCRAPE_USER_AGENT=Mozilla/5.0 (compatible; DataLakeBot/1.0)

# API Configuration
API_HOST=0.0.0.0
API_PORT=8001
API_WORKERS=1


# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# OpenLineage Configuration
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=data-scrape-rag

#LITELLM_MODEL=ollama/llama2
#LITELLM_EMBED_MODEL=ollama/llama2
LITELLM_API_BASE=http://localhost:11434

API_STREAMING_ENABLED=true


OPENLINEAGE_URL=file:///lineage
OPENLINEAGE_TRANSPORT=file
OPENLINEAGE_NAMESPACE=big-data-pipeline


# Send OpenLineage events to Marquez
OPENLINEAGE_URL=http://marquez:5001
OPENLINEAGE_TRANSPORT=http
OPENLINEAGE_NAMESPACE=big-data-pipeline


# Marquez Configuration
POSTGRES_PORT=5432
MARQUEZ_PORT=5001
MARQUEZ_ADMIN_PORT=5002
MARQUEZ_DB=marquez
MARQUEZ_USER=marquez
MARQUEZ_PASSWORD=marquez
POSTGRES_HOST=marquez-db
SEARCH_ENABLED=true

# Marquez Lineage Integration
MARQUEZ_ENABLED=true
MARQUEZ_URL=http://marquez:5001
MARQUEZ_NAMESPACE=data-scrape-rag
